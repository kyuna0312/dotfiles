[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

# BOX UK Contrast — same palette as the rest of the stack.
# syntax-theme "boxuk" comes from config/bat/themes/boxuk.tmTheme via
# bat's theme cache (`bat cache --build` once after linking).
[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    syntax-theme = boxuk
    plus-style = syntax "#12271f"
    plus-emph-style = syntax "#1a3a2c"
    minus-style = syntax "#2a1417"
    minus-emph-style = syntax "#3d1f22"
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#be59d6" box
    file-style = bold "#2bbcd5"
    file-decoration-style = "#0cc7c2" ul
    line-numbers-plus-style = "#49d575"
    line-numbers-minus-style = "#f37c4b"
    line-numbers-zero-style = "#5b7189"
    line-numbers-left-style = "#5b7189"
    line-numbers-right-style = "#5b7189"
    blame-palette = "#101a1f #15242d #1d2c36 #2a3a40"

[merge]
    conflictstyle = diff3
