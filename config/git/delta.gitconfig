[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

# BOX UK Contrast — same palette as the rest of the stack.
# syntax-theme "boxuk" comes from config/bat/themes/boxuk.tmTheme via
# bat's theme cache (`bat cache --build` once after linking).
[delta]
    navigate = true
    line-numbers = true
    side-by-side = true
    syntax-theme = boxuk
    plus-style = syntax "#12271f"
    plus-emph-style = syntax "#1a3a2c"
    minus-style = syntax "#2a1417"
    minus-emph-style = syntax "#3d1f22"
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#b750ae" box
    file-style = bold "#017c9d"
    file-decoration-style = "#15b8ae" ul
    line-numbers-plus-style = "#019d76"
    line-numbers-minus-style = "#f77669"
    line-numbers-zero-style = "#60778c"
    line-numbers-left-style = "#60778c"
    line-numbers-right-style = "#60778c"
    blame-palette = "#161e22 #1b2228 #222c31 #2a3a40"

[merge]
    conflictstyle = diff3
