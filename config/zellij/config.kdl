// Zellij — LUCY UI (Cyberpunk 2077)
// Same night-city palette as tmux/ghostty/kitty/wezterm/starship/nvim.

theme "lucy"

themes {
    lucy {
        fg "#839495"
        bg "#00141a"
        black "#002d38"
        red "#2aa298"
        green "#859900"
        yellow "#b28600"
        blue "#2f879d"
        magenta "#d33682"
        cyan "#4fd1c5"
        white "#839495"
        orange "#b28600"
    }
}

// Behavior consistent with the tmux setup
mouse_mode true
copy_on_select true
pane_frames true
default_layout "compact"
