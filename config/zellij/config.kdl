// Zellij — BOX UK Contrast (rainglow)
// Same palette as tmux/ghostty/kitty/wezterm/starship/nvim.

theme "nightcity"

themes {
    nightcity {
        fg "#b6c5d3"
        bg "#101a1f"
        black "#15242d"
        red "#2bbcd5"
        green "#49d575"
        yellow "#f2c74b"
        blue "#2bbcd5"
        magenta "#be59d6"
        cyan "#0cc7c2"
        white "#b6c5d3"
        orange "#f2c74b"
    }
}

// Behavior consistent with the tmux setup
mouse_mode true
copy_on_select true
pane_frames true
default_layout "compact"
