// Zellij — H4CK3R // LUCY (Cyberpunk: Edgerunners, Lucy Kushinada)
// Same night-city palette as tmux/ghostty/kitty/wezterm/starship/nvim.

theme "lucy"

themes {
    lucy {
        fg "#ff4d5e"
        bg "#080002"
        black "#0e0304"
        red "#ff1e3c"
        green "#39ff88"
        yellow "#fce300"
        blue "#00b4ff"
        magenta "#ff29d4"
        cyan "#00ffc8"
        white "#ff4d5e"
        orange "#ffe66b"
    }
}

// Behavior consistent with the tmux setup
mouse_mode true
copy_on_select true
pane_frames true
default_layout "compact"
