// Zellij — BOX UK Contrast (rainglow)
// Same palette as tmux/ghostty/kitty/wezterm/starship/nvim.

theme "boxuk"

themes {
    boxuk {
        fg "#b8c7cc"
        bg "#161e22"
        black "#1b2228"
        red "#017c9d"
        green "#019d76"
        yellow "#ffcb6e"
        blue "#017c9d"
        magenta "#b750ae"
        cyan "#15b8ae"
        white "#b8c7cc"
        orange "#ffcb6e"
    }
}

// Behavior consistent with the tmux setup
mouse_mode true
copy_on_select true
pane_frames true
default_layout "compact"
