# Ghostty — ARASAKA UI (CyberArch-Dotfiles, Cyberpunk 2077)
# Red-dominant surface (#ff1e3c) with cyan/yellow/magenta/green neon pops.

# ---- ARASAKA palette ----
background = #080002
foreground = #ff4d5e

cursor-color = #ff1e3c
cursor-text = #080002

selection-background = #ff1e3c
selection-foreground = #080002

# normal
palette = 0=#0e0304
palette = 1=#ff1e3c
palette = 2=#39ff88
palette = 3=#fce300
palette = 4=#00b4ff
palette = 5=#ff29d4
palette = 6=#00ffc8
palette = 7=#ff4d5e

# bright
palette = 8=#5a1a24
palette = 9=#ff6b7d
palette = 10=#7dffb5
palette = 11=#ffe66b
palette = 12=#4dd2ff
palette = 13=#ff7de8
palette = 14=#5fffe0
palette = 15=#ff8f9c

# ---- Window ----
background-opacity = 0.8
background-blur-radius = 32
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

# ---- Font ----
font-family = "Hack Nerd Font"

# ---- Cursor ----
cursor-style = bar
cursor-style-blink = true

# ---- macOS keys ----
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
