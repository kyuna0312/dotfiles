# Ghostty — Night City Mix palette, craftzdog-style window feel

# ---- Palette — from the night-city-palettes submodule ----
# ~/.config/themes -> themes/night-city-palettes (linked by install.sh).
# Swap the file name to switch palettes (e.g. box-uk-contrast).
config-file = ../themes/extras/ghostty/night-city-mix

# ---- Window ----
background-opacity = 0.9
background-blur = 20
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

# ---- Font ----
font-family = "Hack Nerd Font"

# ---- Cursor ----
cursor-style = block
cursor-style-blink = true

# ---- macOS keys ----
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
