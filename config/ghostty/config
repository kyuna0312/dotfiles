# Ghostty — craftzdog-style Solarized Osaka
# Matches nvim's solarized-osaka theme; background/opacity/blur per craftzdog.

# ---- Theme ----
# Previous NIGHT CITY palette (switch back by re-enabling config-file):
# config-file = ../themes/extras/ghostty/night-city-mix
theme = "Solarized Osaka Night"
background = #031219

# ---- Window ----
background-opacity = 0.9
background-blur = 20
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

# ---- Font ----
font-family = "Hack Nerd Font"

# ---- Cursor ----
cursor-style = block
cursor-style-blink = true

# ---- macOS keys ----
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
