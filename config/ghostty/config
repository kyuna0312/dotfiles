# Ghostty — LUCY UI (Cyberpunk: Edgerunners, solarized-osaka)
# Teal/cyan surface (#2aa298) with cyan/yellow/magenta/green neon pops.

# ---- LUCY palette ----
background = #00141a
foreground = #839495

cursor-color = #2aa298
cursor-text = #00141a

selection-background = #2aa298
selection-foreground = #00141a

# normal
palette = 0=#00141a
palette = 1=#2aa298
palette = 2=#859900
palette = 3=#b28600
palette = 4=#2f879d
palette = 5=#d33682
palette = 6=#4fd1c5
palette = 7=#839495

# bright
palette = 8=#0e3139
palette = 9=#4fd1c5
palette = 10=#859900
palette = 11=#b28600
palette = 12=#2f879d
palette = 13=#d33682
palette = 14=#4fd1c5
palette = 15=#839495

# ---- Window ----
background-opacity = 0.8
background-blur = 32
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

# ---- Font ----
font-family = "Hack Nerd Font"

# ---- Cursor ----
cursor-style = bar
cursor-style-blink = true

# ---- macOS keys ----
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
