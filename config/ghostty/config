# Ghostty — Box UK Contrast (rainglow)
# Cyan surface (#017c9d) with teal/yellow/purple/green pops.

# ---- Box UK Contrast palette ----
background = #161e22
foreground = #b8c7cc

cursor-color = #017c9d
cursor-text = #161e22

selection-background = #017c9d
selection-foreground = #161e22

# normal
palette = 0=#161e22
palette = 1=#f77669
palette = 2=#019d76
palette = 3=#ffcb6e
palette = 4=#017c9d
palette = 5=#b750ae
palette = 6=#15b8ae
palette = 7=#b8c7cc

# bright
palette = 8=#303b47
palette = 9=#ff5370
palette = 10=#15b8ae
palette = 11=#ffd68a
palette = 12=#2f9dc0
palette = 13=#ff5370
palette = 14=#4fd8ce
palette = 15=#e6e6e6

# ---- Window ----
background-opacity = 0.8
background-blur = 32
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true

# ---- Font ----
font-family = "Hack Nerd Font"

# ---- Cursor ----
cursor-style = bar
cursor-style-blink = true

# ---- macOS keys ----
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind
